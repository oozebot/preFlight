msgstr "Jahr"

#: src/luminary/config/catalog/PrintConfig.cpp:7284
msgid "Month"
msgstr "Monat"

#: src/luminary/config/catalog/PrintConfig.cpp:7287
msgid "Day"
msgstr "Tag"

#: src/luminary/config/catalog/PrintConfig.cpp:7290
msgid "Hour"
msgstr "Stunde"

#: src/luminary/config/catalog/PrintConfig.cpp:7293
msgid "Minute"
msgstr "Minute"

#: src/luminary/config/catalog/PrintConfig.cpp:7296
