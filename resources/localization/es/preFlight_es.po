#: src/luminary/config/catalog/PrintConfig.cpp:6556
msgid "Invalid value for --extruder-clearance-radius"
msgstr "Valor no válido para --extruder-clearance-radius"

#: src/luminary/config/catalog/PrintConfig.cpp:6558
msgid "Invalid value for --extruder-clearance-height"
msgstr "Valor no válido para --extruder-clearance-height"

#: src/luminary/config/catalog/PrintConfig.cpp:6563
msgid "Invalid value for --extrusion-multiplier"
msgstr "Valor no válido para --extrusion-multiplier"

#: src/luminary/config/catalog/PrintConfig.cpp:6582
msgid "Can't make more than one perimeter when spiral vase mode is enabled"
msgstr ""
"No se puede usar más de un perímetro cuando el modo jarrón en espiral está "
"activado"

#: src/luminary/config/catalog/PrintConfig.cpp:6584
msgid "Can't make less than one perimeter when spiral vase mode is enabled"
msgstr ""
"No se puede usar menos de un perímetro cuando el modo jarrón en espiral está "
"activado"

#: src/luminary/config/catalog/PrintConfig.cpp:6586
msgid ""
"Spiral vase mode can only print hollow objects, so you need to set Fill "
"density to 0"
msgstr ""
"El modo jarrón en espiral solo puede imprimir objetos huecos, por lo que "
"debe establecer la Densidad de relleno en 0"

#: src/luminary/config/catalog/PrintConfig.cpp:6588
msgid "Spiral vase mode is not compatible with top solid layers"
msgstr ""
"El modo jarrón en espiral no es compatible con las capas solidas superiores"

#: src/luminary/config/catalog/PrintConfig.cpp:6590
msgid "Spiral vase mode is not compatible with support material"
msgstr "El modo jarrón en espiral no es compatible con el material de soporte"

#: src/luminary/config/catalog/PrintConfig.cpp:6605
