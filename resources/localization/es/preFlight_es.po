msgstr "Cargar archivo de configuración"

#: src/luminary/config/catalog/PrintConfig.cpp:6709
msgid ""
"Load configuration from the specified file. It can be used more than once to "
"load options from multiple files."
msgstr ""
"Cargar la configuración desde el archivo especificado. Se puede usar más de "
"una vez para cargar opciones de varios archivos."

#: src/luminary/config/catalog/PrintConfig.cpp:6734
msgid "Help"
msgstr "Ayuda"

#: src/luminary/config/catalog/PrintConfig.cpp:6735
