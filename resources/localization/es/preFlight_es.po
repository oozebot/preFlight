#: src/luminary/config/catalog/PrintConfig.cpp:5360
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:525
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:527
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:529
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:531
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:533
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:535
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:538
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:540
#: src/DSKY/GUI/Tab.cpp:3645
msgid "Extruders"
msgstr "Extrusores"

#: src/luminary/config/catalog/PrintConfig.cpp:697
msgid ""
"The extruder which determines bed temperatures. Set to 0 to determine "
"temperatures based on the first printing extruder of the first and the "
"second layers."
msgstr ""
"El extrusor que determina las temperaturas de la base. Configúralo a 0 para "
"determinar las temperaturas basadas en el primer extrusor de impresión de la "
"primera y la segunda capa."

#: src/luminary/config/catalog/PrintConfig.cpp:705
#: src/luminary/gcode/emit/GCode.cpp:615
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:975
msgid "Before layer change G-code"
msgstr "Código G para antes del cambio de capa"

#: src/luminary/config/catalog/PrintConfig.cpp:706
msgid ""
"This custom code is inserted at every layer change, right before the Z move. "
"Note that you can use placeholder variables for all preFlight settings as "
"well as [layer_num] and [layer_z]."
msgstr ""
"Este código personalizado se inserta en cada cambio de capa, justo antes del "
"movimiento Z. Tenga en cuenta que puede usar variables de marcador de "
"posición para todos los ajustes de preFlight, así como [layer_num] y "
"[layer_z]."

#: src/luminary/config/catalog/PrintConfig.cpp:716
msgid "Between objects G-code"
msgstr "Código G para entre objetos"

#: src/luminary/config/catalog/PrintConfig.cpp:718
msgid ""
"This code is inserted between objects when using sequential printing. By "
"default extruder and bed temperature are reset using non-wait command; "
"however if M104, M109, M140 or M190 are detected in this custom code, "
"preFlight will not add temperature commands. Note that you can use "
"placeholder variables for all preFlight settings, so you can put a \"M109 "
"S[first_layer_temperature]\" command wherever you want."
msgstr ""
"Este código se inserta entre los objetos cuando se utiliza la impresión "
"secuencial. Por defecto, el extrusor y la temperatura de la base se "
"reinician utilizando un comando de no espera; sin embargo, si se detectan "
"M104, M109, M140 o M190 en este código personalizado, preFlight no agregará "
"comandos de temperatura. Tenga en cuenta que puede usar variables de "
"marcador de posición para todas las configuraciones de preFlight, por lo que "
"puede poner un comando \"M109 S[first_layer_temperature]\" donde lo desee."

#. TRN Print Settings: "Bottom solid layers"
#: src/luminary/config/catalog/PrintConfig.cpp:727
#: src/luminary/config/catalog/PrintConfig.cpp:735
msgctxt "Layers"
msgid "Bottom"
msgstr "Abajo"

#: src/luminary/config/catalog/PrintConfig.cpp:729
msgid "Number of solid layers to generate on bottom surfaces."
msgstr "Número de capas sólidas para generar en las superficies inferiores."

#: src/luminary/config/catalog/PrintConfig.cpp:730
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:47
msgid "Bottom solid layers"
msgstr "Capas sólidas inferiores"

#: src/luminary/config/catalog/PrintConfig.cpp:737
msgid ""
"The number of bottom solid layers is increased above bottom_solid_layers if "
"necessary to satisfy minimum thickness of bottom shell."
msgstr ""
"El número de capas sólidas en la base se incrementa por encima de "
"bottom_solid_layers si es necesario para asegurar un espesor mínimo en la "
"pared de inferior."

#: src/luminary/config/catalog/PrintConfig.cpp:739
msgid "Minimum bottom shell thickness"
msgstr "Espesor mínimo de la carcasa inferior"

#: src/luminary/config/catalog/PrintConfig.cpp:745
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:604
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:782
msgid "Bridge"
msgstr "Puente"

#: src/luminary/config/catalog/PrintConfig.cpp:746
msgid ""
"This is the acceleration your printer will use for bridges. Set zero to "
"disable acceleration control for bridges."
msgstr ""
"Esta es la aceleración que tu impresora usará para los puentes. Establezca "
"con el valor cero para deshabilitar el control de aceleración para puentes."

#: src/luminary/config/catalog/PrintConfig.cpp:748
#: src/luminary/config/catalog/PrintConfig.cpp:1237
#: src/luminary/config/catalog/PrintConfig.cpp:2006
#: src/luminary/config/catalog/PrintConfig.cpp:2016
