#: src/slic3r/GUI/GUI_ObjectManipulation.cpp:853
#: src/slic3r/GUI/Sidebar.cpp:1822
msgid "Scale"
msgstr "Verschaal"

#: src/libslic3r/PrintConfig.cpp:7788
msgid "Scaling factor or percentage."
msgstr "Schalingsfactor of percentage."

#: src/libslic3r/PrintConfig.cpp:7792 src/slic3r/GUI/GUI_Factories.cpp:1360
#: src/slic3r/GUI/GUI_Factories.cpp:1392
msgid "Split"
msgstr "Splits"

#: src/libslic3r/PrintConfig.cpp:7793
msgid ""
"Detect unconnected parts in the given model(s) and split them into separate "
"objects."
msgstr ""
"Detecteer niet-verbonden onderdelen in het model en deel ze op in "
"verschillende objecten."

#: src/libslic3r/PrintConfig.cpp:7796
msgid "Scale to Fit"
msgstr "Verschaal naar passing"

#: src/libslic3r/PrintConfig.cpp:7797
msgid "Scale to fit the given volume."
msgstr "Verschaal naar passing in het gegeven volume."

#: src/libslic3r/PrintConfig.cpp:7806
msgid "Ignore non-existent config files"
msgstr "Negeer niet-bestaande configuratiebestanden"

#: src/libslic3r/PrintConfig.cpp:7807
msgid "Do not fail if a file supplied to --load does not exist."
msgstr "Geef geen fout als een bestand om te laden niet bestaat."

#: src/libslic3r/PrintConfig.cpp:7811
msgid ""
"Forward-compatibility rule when loading configurations from config files and "
"project files (3MF, AMF)."
msgstr ""
"Doorgang-compatibiliteitsregel bij het laden van configuraties van "
"configuratie- en projectbestanden (3MF, AMF)."

#: src/libslic3r/PrintConfig.cpp:7813
msgid ""
"This version of preFlight may not understand configurations produced by the "
"newest preFlight versions. For example, newer preFlight may extend the list "
"of supported firmware flavors. One may decide to bail out or to substitute "
"an unknown value with a default silently or verbosely."
msgstr ""
"Deze versie van preFlight snapt configuraties geproduceerd door nieuwere "
"versie van preFlight niet. Ter illustratie: nieuwere versies van preFlight "
"ondersteunen meer firmwarevarianten. Besloten kan worden om een onbekende "
"waarde zonder melding of woordelijk te vervangen door een standaardwaarde."

#: src/libslic3r/PrintConfig.cpp:7818
msgid "Bail out on unknown configuration values"
msgstr "Sla onbekende configuratiewaarden over"

#: src/libslic3r/PrintConfig.cpp:7819
msgid ""
"Enable reading unknown configuration values by verbosely substituting them "
"with defaults."
msgstr ""
"Sta to om onbekende configuratiewaarden te lezen door woordelijk te "
"substitueren met standaardwaarden."

#: src/libslic3r/PrintConfig.cpp:7821
msgid ""
"Enable reading unknown configuration values by silently substituting them "
"with defaults."
msgstr ""
"Sta to om onbekende configuratiewaarden te lezen door zonder melding te "
"substitueren met standaardwaarden."

#: src/libslic3r/PrintConfig.cpp:7826
msgid "Output File"
msgstr "Outputbestand"

#: src/libslic3r/PrintConfig.cpp:7828
msgid ""
"The file where the output will be written (if not specified, it will be "
"based on the input file)."
msgstr ""
"Het bestand waaroverheen wordt geschreven (als dit niet aangegeven is, wort "
"dit gebaseerd op het inputbestand)."

#: src/libslic3r/PrintConfig.cpp:7832
msgid "Data directory"
msgstr "Bestandslocatie voor de data"

#: src/libslic3r/PrintConfig.cpp:7834
msgid ""
"Load and store settings at the given directory. This is useful for "
"maintaining different profiles or including configurations from a network "
"storage."
msgstr ""
"Laad fabrieksinstellingen en sla op. Dit is handig voor het onderhouden van "
"verschillende profielen of het opnemen van configuraties van een "
"netwerkopslag."

#: src/libslic3r/PrintConfig.cpp:7837
msgid "Maximum number of threads"
msgstr "Maximaal aantal threads"

#: src/libslic3r/PrintConfig.cpp:7839
msgid ""
"Sets the maximum number of threads the slicing process will use. If not "
"defined, it will be decided automatically."
msgstr ""
"Stelt het maximale aantal threads in dat het sliceproces gebruikt. Indien "
"niet gedefinieerd, wordt dit automatisch bepaald."

#: src/libslic3r/PrintConfig.cpp:7843
msgid "Logging level"
msgstr "Logboekniveau"

#: src/libslic3r/PrintConfig.cpp:7844
msgid ""
"Sets logging sensitivity. 0:fatal, 1:error, 2:warning, 3:info, 4:debug, "
"5:trace\n"
"For example. loglevel=2 logs fatal, error and warning level messages."
msgstr ""
"Stel log-gevoeligheid in. 0: fataal, 1: fout, 2: waarschuwing, 3: info, 4: "
"debug, 5: traceer\n"
"Voorbeeld: loglevel = 2 geeft fataal-, fout- en waarschuwingslevelberichten."

#: src/libslic3r/PrintConfig.cpp:7849
msgid "Debug output categories"
msgstr "Debug-uitvoercategorieën"

#: src/libslic3r/PrintConfig.cpp:7859
msgid "Automatic OpenGL antialiasing samples number selection"
msgstr "Automatische selectie van het aantal OpenGL-antialiasingsamples"

#: src/libslic3r/PrintConfig.cpp:7860
msgid ""
"Automatically select the highest number of samples for OpenGL antialiasing."
msgstr ""
"Selecteer automatisch het hoogste aantal samples voor OpenGL-antialiasing."

#: src/libslic3r/PrintConfig.cpp:7866
msgid "OpenGL version"
msgstr "OpenGL-versie"

#: src/libslic3r/PrintConfig.cpp:7867
msgid "Select a specific version of OpenGL"
msgstr "Selecteer een specifieke versie van OpenGL"

#: src/libslic3r/PrintConfig.cpp:7872
msgid "OpenGL compatibility profile"
msgstr "OpenGL-compatibiliteitsprofiel"

#: src/libslic3r/PrintConfig.cpp:7873
msgid "Enable OpenGL compatibility profile"
msgstr "OpenGL-compatibiliteitsprofiel inschakelen"

#: src/libslic3r/PrintConfig.cpp:7878
msgid "OpenGL debug output"
msgstr "OpenGL-foutopsporingsuitvoer"

#: src/libslic3r/PrintConfig.cpp:7879
msgid ""
"Activate OpenGL debug output on graphic cards which support it (OpenGL 4.3 "
"or higher)"
msgstr ""
"Activeer OpenGL-foutopsporingsuitvoer op grafische kaarten die dit "
"ondersteunen (OpenGL 4.3 of hoger)"

#: src/libslic3r/PrintConfig.cpp:7885
msgid "Single instance mode"
msgstr "Enkele instantiemodus"

#: src/libslic3r/PrintConfig.cpp:7886
msgid ""
"If enabled, the command line arguments are sent to an existing instance of "
"GUI preFlight, or an existing preFlight window is activated. Overrides the "
"\"single_instance\" configuration value from application preferences."
msgstr ""
"Als dit is ingeschakeld worden de commando-argumenten naar een bestaande "
"instantie van de preFlight GUI of een geopend preFlight venster gestuurd. "
"Dit overschrijft de \"enkele instantie\"-configuratiewaarde van de "
"programmavoorkeuren."

#: src/libslic3r/PrintConfig.cpp:7891
msgid "Delete files after loading"
msgstr "Bestanden verwijderen na laden"

#: src/libslic3r/PrintConfig.cpp:7892
msgid "Delete files after loading."
msgstr "Bestanden verwijderen na laden."

#: src/libslic3r/PrintConfig.cpp:7896
msgid "Render with a software renderer"
msgstr "Render met software-renderer"

#: src/libslic3r/PrintConfig.cpp:7898
msgid ""
"Render with a software renderer. The bundled MESA software renderer is "
"loaded instead of the default OpenGL driver."
msgstr ""
"Render met software-renderer. De meegeleverde MESA-software-renderer is "
"geladen in plaats van het standaard OpenGL stuurprogramma."

#: src/libslic3r/PrintConfig.cpp:7926
msgid "Current z-hop"
msgstr "Huidige z-hop"

#: src/libslic3r/PrintConfig.cpp:7927
msgid "Contains z-hop present at the beginning of the custom G-code block."
msgstr ""
"Bevat de z-hop die aanwezig is aan het begin van het aangepaste G-code-blok."

#: src/libslic3r/PrintConfig.cpp:7935
#: src/slic3r/GUI/GUI_ObjectManipulation.cpp:277
#: src/slic3r/GUI/GUI_ObjectManipulation.cpp:768
msgid "Position"
msgstr "Positie"

#: src/libslic3r/PrintConfig.cpp:7937
msgid ""
"Position of the extruder at the beginning of the custom G-code block. If the "
"custom G-code travels somewhere else, it should write to this variable so "
"preFlight knows where it travels from when it gets control back."
msgstr ""
"Positie van de extruder aan het begin van het aangepaste G-code-blok. Als de "
"aangepaste G-code ergens anders naartoe beweegt, moet deze naar deze "
"variabele schrijven zodat preFlight weet vanwaar het beweegt wanneer het de "
"controle terugkrijgt."

#: src/libslic3r/PrintConfig.cpp:7941 src/slic3r/GUI/Sidebar.cpp:7085
msgid "Retraction"
msgstr "Retractie"

#: src/libslic3r/PrintConfig.cpp:7943
msgid ""
"Retraction state at the beginning of the custom G-code block. If the custom "
"G-code moves the extruder axis, it should write to this variable so "
"preFlight deretracts correctly when it gets control back."
msgstr ""
"Retractietoestand aan het begin van het aangepaste G-code-blok. Als de "
"aangepaste G-code de extruder-as beweegt, moet deze naar deze variabele "
"schrijven zodat preFlight correct de-retracteert wanneer het de controle "
"terugkrijgt."

#: src/libslic3r/PrintConfig.cpp:7947
msgid "Extra deretraction"
msgstr "Extra de-retractie"

#: src/libslic3r/PrintConfig.cpp:7948
msgid "Currently planned extra extruder priming after deretraction."
msgstr "Momenteel geplande extra extruder-priming na de-retractie."

#: src/libslic3r/PrintConfig.cpp:7951
msgid "Absolute E position"
msgstr "Absolute E-positie"

#: src/libslic3r/PrintConfig.cpp:7952
msgid ""
"Current position of the extruder axis. Only used with absolute extruder "
"addressing."
msgstr ""
"Huidige positie van de extruder-as. Wordt alleen gebruikt met absolute "
"extruder-adressering."

#: src/libslic3r/PrintConfig.cpp:7960
msgid "Current extruder"
msgstr "Huidige extruder"

#: src/libslic3r/PrintConfig.cpp:7961
msgid "Zero-based index of currently used extruder."
msgstr "Nulgebaseerde index van de momenteel gebruikte extruder."

#: src/libslic3r/PrintConfig.cpp:7964
msgid "Current object index"
msgstr "Huidige objectindex"

#: src/libslic3r/PrintConfig.cpp:7965
msgid ""
"Specific for sequential printing. Zero-based index of currently printed "
"object."
msgstr ""
"Specifiek voor sequentieel printen. Nulgebaseerde index van het momenteel "
"geprinte object."

#: src/libslic3r/PrintConfig.cpp:7968
msgid "Has single extruder MM priming"
msgstr "Heeft enkele-extruder-MM-priming"

#: src/libslic3r/PrintConfig.cpp:7969
msgid "Are the extra multi-material priming regions used in this print?"
msgstr "Worden de extra multimateriaal-priminggebieden in deze print gebruikt?"

#: src/libslic3r/PrintConfig.cpp:7972
msgid "Has wipe tower"
msgstr "Heeft veegtoren"

#: src/libslic3r/PrintConfig.cpp:7973
msgid "Whether or not wipe tower is being generated in the print."
msgstr "Of er al dan niet een veegtoren in de print wordt gegenereerd."

#: src/libslic3r/PrintConfig.cpp:7976
msgid "Initial extruder"
msgstr "Begin-extruder"

#: src/libslic3r/PrintConfig.cpp:7977
msgid ""
"Zero-based index of the first extruder used in the print. Same as "
"initial_tool."
msgstr ""
"Nulgebaseerde index van de eerste extruder die in de print wordt gebruikt. "
"Hetzelfde als initial_tool."

#. TRN: Meaning 'filament type of the initial filament'
#: src/libslic3r/PrintConfig.cpp:7981
msgid "Initial filament type"
msgstr "Begin-filamenttype"

#: src/libslic3r/PrintConfig.cpp:7982
msgid "String containing filament type of the first used extruder."
msgstr "Tekenreeks met het filamenttype van de eerst gebruikte extruder."

#: src/libslic3r/PrintConfig.cpp:7985
msgid "Initial tool"
msgstr "Begin-tool"

#: src/libslic3r/PrintConfig.cpp:7986
msgid ""
"Zero-based index of the first extruder used in the print. Same as "
"initial_extruder."
msgstr ""
"Nulgebaseerde index van de eerste extruder die in de print wordt gebruikt. "
"Hetzelfde als initial_extruder."

#: src/libslic3r/PrintConfig.cpp:7989
msgid "Is extruder used?"
msgstr "Wordt extruder gebruikt?"

#: src/libslic3r/PrintConfig.cpp:7990
msgid ""
"Vector of booleans stating whether a given extruder is used in the print."
msgstr ""
"Vector van booleans die aangeeft of een bepaalde extruder in de print wordt "
"gebruikt."

#: src/libslic3r/PrintConfig.cpp:7998
msgid "Volume per extruder"
msgstr "Volume per extruder"

#: src/libslic3r/PrintConfig.cpp:7999
msgid "Total filament volume extruded per extruder during the entire print."
msgstr ""
"Totaal geëxtrudeerd filamentvolume per extruder gedurende de hele print."

#: src/libslic3r/PrintConfig.cpp:8002 src/libslic3r/PrintConfig.cpp:8010
msgid "Print time (normal mode)"
msgstr "Printtijd (normale modus)"

#: src/libslic3r/PrintConfig.cpp:8003
msgid ""
"Estimated print time when printed in normal mode (i.e. not in silent mode). "
"Same as print_time."
msgstr ""
"Geschatte printtijd bij printen in de normale modus (d.w.z. niet in stille "
"modus). Hetzelfde als print_time."

#: src/libslic3r/PrintConfig.cpp:8006
msgid "Number of printing extruders"
msgstr "Aantal printende extruders"

#: src/libslic3r/PrintConfig.cpp:8007
msgid "Number of extruders used during the print."
msgstr "Aantal extruders dat tijdens de print wordt gebruikt."

#: src/libslic3r/PrintConfig.cpp:8012
msgid ""
"Estimated print time when printed in normal mode (i.e. not in silent mode). "
"Same as normal_print_time."
msgstr ""
"Geschatte printtijd bij printen in de normale modus (d.w.z. niet in stille "
"modus). Hetzelfde als normal_print_time."

#: src/libslic3r/PrintConfig.cpp:8015
msgid "Used filament types"
msgstr "Gebruikte filamenttypen"

#: src/libslic3r/PrintConfig.cpp:8016
msgid "Comma-separated list of all filament types used during the print."
msgstr ""
"Door komma's gescheiden lijst met alle filamenttypen die tijdens de print "
"worden gebruikt."

#: src/libslic3r/PrintConfig.cpp:8019
msgid "Print time (silent mode)"
msgstr "Printtijd (stille modus)"

#: src/libslic3r/PrintConfig.cpp:8020
msgid "Estimated print time when printed in silent mode."
msgstr "Geschatte printtijd bij printen in de stille modus."

#: src/libslic3r/PrintConfig.cpp:8023
msgid "Total cost"
msgstr "Totale kosten"

#: src/libslic3r/PrintConfig.cpp:8024
msgid ""
"Total cost of all material used in the print. Calculated from cost in "
"Filament Settings."
msgstr ""
"Totale kosten van al het materiaal dat in de print wordt gebruikt. Berekend "
"op basis van de kosten in de filamentinstellingen."

#: src/libslic3r/PrintConfig.cpp:8027 src/libslic3r/PrintConfig.cpp:8056
msgid "Total weight"
msgstr "Totaalgewicht"

#: src/libslic3r/PrintConfig.cpp:8028 src/libslic3r/PrintConfig.cpp:8057
msgid ""
"Total weight of the print. Calculated from density in Filament Settings."
msgstr ""
"Totaalgewicht van de print. Berekend op basis van de dichtheid in de "
"filamentinstellingen."

#: src/libslic3r/PrintConfig.cpp:8031
msgid "Total wipe tower cost"
msgstr "Totale kosten veegtoren"

#: src/libslic3r/PrintConfig.cpp:8032
msgid ""
"Total cost of the material wasted on the wipe tower. Calculated from cost in "
"Filament Settings."
msgstr ""
"Totale kosten van het materiaal dat op de veegtoren wordt verspild. Berekend "
"op basis van de kosten in de filamentinstellingen."

#: src/libslic3r/PrintConfig.cpp:8035
msgid "Wipe tower volume"
msgstr "Volume veegtoren"

#: src/libslic3r/PrintConfig.cpp:8036
msgid "Total filament volume extruded on the wipe tower."
msgstr "Totaal geëxtrudeerd filamentvolume op de veegtoren."

#: src/libslic3r/PrintConfig.cpp:8039 src/slic3r/GUI/GCodeViewer.cpp:3729
#: src/slic3r/GUI/GCodeViewer.cpp:3731 src/slic3r/GUI/GCodeViewer.cpp:4129
msgid "Used filament"
msgstr "Gebruikt filament"

#: src/libslic3r/PrintConfig.cpp:8040
msgid "Total length of filament used in the print."
msgstr "Totale lengte filament die in de print wordt gebruikt."

#: src/libslic3r/PrintConfig.cpp:8043
msgid "Total number of toolchanges"
msgstr "Totaal aantal tool-wissels"

#: src/libslic3r/PrintConfig.cpp:8044
msgid "Number of toolchanges during the print."
msgstr "Aantal tool-wissels tijdens de print."

#: src/libslic3r/PrintConfig.cpp:8047
msgid "Total volume"
msgstr "Totaal volume"

#: src/libslic3r/PrintConfig.cpp:8048
msgid "Total volume of filament used during the entire print."
msgstr "Totaal filamentvolume dat gedurende de hele print wordt gebruikt."

#: src/libslic3r/PrintConfig.cpp:8051
msgid "Weight per extruder"
msgstr "Gewicht per extruder"

#: src/libslic3r/PrintConfig.cpp:8053
msgid ""
"Weight per extruder extruded during the entire print. Calculated from "
"density in Filament Settings."
msgstr ""
"Gewicht per extruder dat gedurende de hele print wordt geëxtrudeerd. "
"Berekend op basis van de dichtheid in de filamentinstellingen."

#: src/libslic3r/PrintConfig.cpp:8060
msgid "Total layer count"
msgstr "Totaal aantal lagen"

#: src/libslic3r/PrintConfig.cpp:8061
msgid "Number of layers in the entire print."
msgstr "Aantal lagen in de hele print."

#: src/libslic3r/PrintConfig.cpp:8069
msgid "Number of objects"
msgstr "Aantal objecten"

#: src/libslic3r/PrintConfig.cpp:8070
msgid "Total number of objects in the print."
msgstr "Totaal aantal objecten in de print."

#: src/libslic3r/PrintConfig.cpp:8073
msgid "Number of instances"
msgstr "Aantal instanties"

#: src/libslic3r/PrintConfig.cpp:8074
msgid "Total number of object instances in the print, summed over all objects."
msgstr ""
"Totaal aantal objectinstanties in de print, opgeteld over alle objecten."

#: src/libslic3r/PrintConfig.cpp:8077
msgid "Scale per object"
msgstr "Schaal per object"

#: src/libslic3r/PrintConfig.cpp:8078
msgid ""
"Contains a string with the information about what scaling was applied to the "
"individual objects. Indexing of the objects is zero-based (first object has "
"index 0).\n"
"Example: 'x:100% y:50% z:100%'."
msgstr ""
"Bevat een tekenreeks met informatie over welke schaling op de individuele "
"objecten is toegepast. De indexering van de objecten is nulgebaseerd (het "
"eerste object heeft index 0).\n"
"Voorbeeld: 'x:100% y:50% z:100%'."

#: src/libslic3r/PrintConfig.cpp:8083
msgid "Input filename without extension"
msgstr "Invoerbestandsnaam zonder extensie"

#: src/libslic3r/PrintConfig.cpp:8084
msgid "Source filename of the first object, without extension."
msgstr "Bronbestandsnaam van het eerste object, zonder extensie."

#: src/libslic3r/PrintConfig.cpp:8091
msgid ""
"The vector has two elements: x and y coordinate of the point. Values in mm."
msgstr ""
"De vector heeft twee elementen: x- en y-coördinaat van het punt. Waarden in "
"mm."

#: src/libslic3r/PrintConfig.cpp:8093
msgid ""
"The vector has two elements: x and y dimension of the bounding box. Values "
"in mm."
msgstr ""
"De vector heeft twee elementen: x- en y-afmeting van de begrenzingsbox. "
"Waarden in mm."

#: src/libslic3r/PrintConfig.cpp:8096
msgid "First layer convex hull"
msgstr "Convexe omhulling eerste laag"

#: src/libslic3r/PrintConfig.cpp:8097
msgid ""
"Vector of points of the first layer convex hull. Each element has the "
"following format: '[x, y]' (x and y are floating-point numbers in mm)."
msgstr ""
"Vector van punten van de convexe omhulling van de eerste laag. Elk element "
"heeft het volgende formaat: '[x, y]' (x en y zijn drijvendekommagetallen in "
"mm)."

#: src/libslic3r/PrintConfig.cpp:8101
msgid "Bottom-left corner of first layer bounding box"
msgstr "Linkeronderhoek van de begrenzingsbox van de eerste laag"

#: src/libslic3r/PrintConfig.cpp:8105
msgid "Top-right corner of first layer bounding box"
msgstr "Rechterbovenhoek van de begrenzingsbox van de eerste laag"

#: src/libslic3r/PrintConfig.cpp:8109
msgid "Size of the first layer bounding box"
msgstr "Grootte van de begrenzingsbox van de eerste laag"

#: src/libslic3r/PrintConfig.cpp:8113
msgid "Bottom-left corner of print bed bounding box"
msgstr "Linkeronderhoek van de begrenzingsbox van het printbed"

#: src/libslic3r/PrintConfig.cpp:8117
msgid "Top-right corner of print bed bounding box"
msgstr "Rechterbovenhoek van de begrenzingsbox van het printbed"

#: src/libslic3r/PrintConfig.cpp:8121
msgid "Size of the print bed bounding box"
msgstr "Grootte van de begrenzingsbox van het printbed"

#: src/libslic3r/PrintConfig.cpp:8130
msgid "Timestamp"
msgstr "Tijdstempel"

#: src/libslic3r/PrintConfig.cpp:8131
msgid "String containing current time in yyyyMMdd-hhmmss format."
msgstr "Tekenreeks met de huidige tijd in het formaat yyyyMMdd-hhmmss."

#: src/libslic3r/PrintConfig.cpp:8134
msgid "Year"
msgstr "Jaar"

#: src/libslic3r/PrintConfig.cpp:8137
msgid "Month"
msgstr "Maand"

#: src/libslic3r/PrintConfig.cpp:8140
msgid "Day"
msgstr "Dag"

#: src/libslic3r/PrintConfig.cpp:8143
msgid "Hour"
msgstr "Uur"

#: src/libslic3r/PrintConfig.cpp:8146
msgid "Minute"
msgstr "Minuut"

#: src/libslic3r/PrintConfig.cpp:8149
msgid "Second"
msgstr "Seconde"

#: src/libslic3r/PrintConfig.cpp:8157
msgid "Number of extruders"
msgstr "Aantal extruders"

#: src/libslic3r/PrintConfig.cpp:8158
msgid ""
"Total number of extruders, regardless of whether they are used in the "
"current print."
msgstr ""
"Totaal aantal extruders, ongeacht of ze in de huidige print worden gebruikt."

#: src/libslic3r/PrintConfig.cpp:8161
msgid "Print preset name"
msgstr "Naam printpreset"

#: src/libslic3r/PrintConfig.cpp:8162
msgid "Name of the print preset used for slicing."
msgstr "Naam van de printpreset die voor het slicen wordt gebruikt."

#: src/libslic3r/PrintConfig.cpp:8165
msgid "Filament preset name"
msgstr "Naam filamentpreset"

#: src/libslic3r/PrintConfig.cpp:8166
msgid ""
"Names of the filament presets used for slicing. The variable is a vector "
"containing one name for each extruder."
msgstr ""
"Namen van de filamentpresets die voor het slicen worden gebruikt. De "
"variabele is een vector met één naam voor elke extruder."

#: src/libslic3r/PrintConfig.cpp:8170
msgid "Printer preset name"
msgstr "Naam printerpreset"

#: src/libslic3r/PrintConfig.cpp:8171
msgid "Name of the printer preset used for slicing."
