#: src/libslic3r/PrintConfig.cpp:7777
msgid "Rotate around X"
msgstr "Draai over de X-as"

#: src/libslic3r/PrintConfig.cpp:7778
msgid "Rotation angle around the X axis in degrees."
msgstr "Rotatiehoek rond de X-as in graden."

#: src/libslic3r/PrintConfig.cpp:7782
msgid "Rotate around Y"
msgstr "Draai over de Y-as"

#: src/libslic3r/PrintConfig.cpp:7783
msgid "Rotation angle around the Y axis in degrees."
msgstr "Rotatiehoek rond de Y-as in graden."

#: src/libslic3r/PrintConfig.cpp:7787
