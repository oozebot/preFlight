"The selected amf file has been saved with a newer version of %1% and is not "
"compatible."
msgstr ""
"Wybrany plik amf został zapisany przy pomocy nowszej wersji %1% i nie jest "
"kompatybilny."

#: src/luminary/format/reader/FileReader.cpp:75
msgid ""
"Unknown file format. Input file must "
"have .stl, .obj, .step/.stp, .svg, .amf(.xml) or extension .3mf(.zip)."
msgstr ""
"Nieznany format pliku. Plik wejściowy musi mieć "
"rozszerzenie .stl, .obj, .step/.stp, .svg, .amf(.xml) lub .3mf(.zip)."

#: src/luminary/format/reader/FileReader.cpp:78
#: src/luminary/format/reader/FileReader.cpp:124
msgid "Loading of a model file failed."
msgstr "Wczytywanie pliku modelu nie powiodło się."

#: src/luminary/format/reader/FileReader.cpp:81
#: src/luminary/format/reader/FileReader.cpp:127
msgid "The supplied file couldn't be read because it's empty"
msgstr "Nie można odczytać podanego pliku, ponieważ jest pusty"

#: src/luminary/format/reader/FileReader.cpp:121
