msgstr "打印过程中使用的所有耗材类型的逗号分隔列表。"

#: src/libslic3r/PrintConfig.cpp:8019
msgid "Print time (silent mode)"
msgstr "打印时间（静音模式）"

#: src/libslic3r/PrintConfig.cpp:8020
msgid "Estimated print time when printed in silent mode."
msgstr "以静音模式打印时的估计打印时间。"

#: src/libslic3r/PrintConfig.cpp:8023
msgid "Total cost"
msgstr "总成本"

#: src/libslic3r/PrintConfig.cpp:8024
msgid ""
"Total cost of all material used in the print. Calculated from cost in "
"Filament Settings."
msgstr "打印中使用的所有材料的总成本。根据耗材设置中的成本计算。"

#: src/libslic3r/PrintConfig.cpp:8027 src/libslic3r/PrintConfig.cpp:8056
msgid "Total weight"
msgstr "总重量"

#: src/libslic3r/PrintConfig.cpp:8028 src/libslic3r/PrintConfig.cpp:8057
msgid ""
"Total weight of the print. Calculated from density in Filament Settings."
msgstr "打印件的总重量。根据耗材设置中的密度计算。"

#: src/libslic3r/PrintConfig.cpp:8031
