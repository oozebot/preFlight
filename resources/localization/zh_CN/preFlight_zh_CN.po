msgstr "最深可用"

#: src/libslic3r/PrintConfig.cpp:508
msgid "Lightest available"
msgstr "最浅可用"

#: src/libslic3r/PrintConfig.cpp:509
msgid "Volume default"
msgstr "体积默认"

