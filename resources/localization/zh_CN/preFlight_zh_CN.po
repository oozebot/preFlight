#: src/slic3r/GUI/GCodeViewer.cpp:3731 src/slic3r/GUI/GCodeViewer.cpp:4129
msgid "Used filament"
msgstr "消耗耗材"

#: src/libslic3r/PrintConfig.cpp:8040
msgid "Total length of filament used in the print."
msgstr "打印中使用的耗材总长度。"

#: src/libslic3r/PrintConfig.cpp:8043
msgid "Total number of toolchanges"
msgstr "换头总次数"

#: src/libslic3r/PrintConfig.cpp:8044
