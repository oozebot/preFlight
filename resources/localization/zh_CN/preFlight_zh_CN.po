msgstr "仅最上面的表面"

#: src/libslic3r/PrintConfig.cpp:997 src/slic3r/GUI/Sidebar.cpp:1833
msgid "Only one perimeter on first layer"
msgstr "首层只用一条轮廓"

#: src/libslic3r/PrintConfig.cpp:999
msgid "Use only one perimeter on the first layer."
msgstr "在首层只使用一条轮廓。"

