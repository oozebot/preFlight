msgid "Can't make more than one perimeter when spiral vase mode is enabled"
msgstr "启用螺旋花瓶模式后，不能使用一个以上的轮廓"

#: src/luminary/config/catalog/PrintConfig.cpp:6584
msgid "Can't make less than one perimeter when spiral vase mode is enabled"
msgstr "启用螺旋花瓶模式后，不能使用少于一个的轮廓"

