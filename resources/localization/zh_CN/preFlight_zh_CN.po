#: src/DSKY/GUI/ExtruderSequenceDialog.cpp:69
msgid "layers"
msgstr "层"

#: src/luminary/config/catalog/PrintConfig.cpp:1267
msgid "Don't support bridges"
msgstr "不支持桥接"

#: src/luminary/config/catalog/PrintConfig.cpp:1269
msgid ""
"Experimental option for preventing support material from being generated "
"under bridged areas."
msgstr "防止在桥接区域下生成支撑材料的实验选项。"

#: src/luminary/config/catalog/PrintConfig.cpp:1275
msgid "Distance between copies"
msgstr "副本之间的距离"

#: src/luminary/config/catalog/PrintConfig.cpp:1276
msgid "Distance used for the auto-arrange feature of the plater."
msgstr "用于构建板自动排列功能的距离。"

#: src/luminary/config/catalog/PrintConfig.cpp:1283
#: src/luminary/config/catalog/PrintConfig.cpp:1293
#: src/luminary/gcode/emit/GCode.cpp:613
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:917
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:973
msgid "End G-code"
msgstr "结尾 G-Code"

#: src/luminary/config/catalog/PrintConfig.cpp:1284
msgid ""
"This end procedure is inserted at the end of the output file. Note that you "
"can use placeholder variables for all preFlight settings."
msgstr ""
"此结束过程插入到输出文件的末尾。请注意，您可以将占位符变量用于所有 preFlight "
"设置。"

#: src/luminary/config/catalog/PrintConfig.cpp:1294
msgid ""
"This end procedure is inserted at the end of the output file, before the "
"printer end gcode (and before any toolchange from this filament in case of "
"multimaterial printers). Note that you can use placeholder variables for all "
"preFlight settings. If you have multiple extruders, the gcode is processed "
"in extruder order."
msgstr ""
"此结束过程插入输出文件的末尾、打印机结束 G-Code 之前（以及多材料打印机情况下"
"从该耗材换出任何工具之前）。请注意，您可以将占位符变量用于所有 preFlight 设"
"置。如果您有多个挤出机，则按挤出机顺序处理 G-Code。"

#: src/luminary/config/catalog/PrintConfig.cpp:1305
msgid "Ensure vertical shell thickness"
msgstr "确保垂直壳层厚度"

#: src/luminary/config/catalog/PrintConfig.cpp:1307
msgid ""
"Add solid infill near sloping surfaces to guarantee the vertical shell "
"thickness (top+bottom solid layers)."
msgstr "在倾斜表面附近添加实心填充，以保证垂直壳层厚度（顶部+底部实心层）。"

#. TRN: This is a drop-down option for 'Ensure vertical shell thickness' parameter.
#: src/luminary/config/catalog/PrintConfig.cpp:1312
msgid "Partial"
msgstr "部分"

#: src/luminary/config/catalog/PrintConfig.cpp:1313
#: src/luminary/config/catalog/PrintConfig.cpp:4161
msgid "Enabled"
msgstr "启用"

#: src/luminary/config/catalog/PrintConfig.cpp:1319
msgid "Top solid fill pattern"
msgstr "顶部实心填充图案"

#: src/luminary/config/catalog/PrintConfig.cpp:1322
msgid ""
"Fill pattern for top infill. This only affects the top visible layer, and "
"not its adjacent solid shells."
msgstr "填充顶部填充的模式。这仅影响顶部可见图层，而不影响其相邻的实体壳。"

#: src/luminary/config/catalog/PrintConfig.cpp:1327
#: src/luminary/config/catalog/PrintConfig.cpp:1963
#: src/luminary/config/catalog/PrintConfig.cpp:1990
#: src/luminary/config/catalog/PrintConfig.cpp:4704
#: src/luminary/config/catalog/PrintConfig.cpp:4727
msgid "Rectilinear"
msgstr "直线"

#: src/luminary/config/catalog/PrintConfig.cpp:1328
#: src/luminary/config/catalog/PrintConfig.cpp:1991
msgid "Monotonic"
msgstr "单调的"

#: src/luminary/config/catalog/PrintConfig.cpp:1329
#: src/luminary/config/catalog/PrintConfig.cpp:1992
msgid "Monotonic Lines"
msgstr "单调线条"

#: src/luminary/config/catalog/PrintConfig.cpp:1330
#: src/luminary/config/catalog/PrintConfig.cpp:1964
#: src/luminary/config/catalog/PrintConfig.cpp:1993
msgid "Aligned Rectilinear"
msgstr "直线排列"

#: src/luminary/config/catalog/PrintConfig.cpp:1331
#: src/luminary/config/catalog/PrintConfig.cpp:1994
msgid "Aligned Monotonic"
msgstr "对齐单调"

#: src/luminary/config/catalog/PrintConfig.cpp:1332
#: src/luminary/config/catalog/PrintConfig.cpp:1970
#: src/luminary/config/catalog/PrintConfig.cpp:1995
#: src/luminary/config/catalog/PrintConfig.cpp:4727
msgid "Concentric"
msgstr "回环"

#: src/luminary/config/catalog/PrintConfig.cpp:1333
#: src/luminary/config/catalog/PrintConfig.cpp:1974
#: src/luminary/config/catalog/PrintConfig.cpp:1996
msgid "Hilbert Curve"
msgstr "希尔伯特曲线"

#: src/luminary/config/catalog/PrintConfig.cpp:1334
#: src/luminary/config/catalog/PrintConfig.cpp:1975
#: src/luminary/config/catalog/PrintConfig.cpp:1997
msgid "Archimedean Chords"
msgstr "阿基米德和弦"

#: src/luminary/config/catalog/PrintConfig.cpp:1335
#: src/luminary/config/catalog/PrintConfig.cpp:1976
#: src/luminary/config/catalog/PrintConfig.cpp:1998
msgid "Octagram Spiral"
msgstr "八角螺旋"

#: src/luminary/config/catalog/PrintConfig.cpp:1341
msgid "Bottom solid fill pattern"
msgstr "底部实心填充图案"

#: src/luminary/config/catalog/PrintConfig.cpp:1344
msgid ""
"Fill pattern for bottom infill. This only affects the bottom external "
"visible layer, and not its adjacent solid shells."
msgstr "填充底部填充的模式。这仅影响底部外部可见图层，而不影响其相邻的实体壳。"

#: src/luminary/config/catalog/PrintConfig.cpp:1354
msgid ""
"Set this to a non-zero value to set a manual extrusion width for external "
"perimeters. If left zero, default extrusion width will be used if set, "
"otherwise 1.125 x nozzle diameter will be used. If expressed as percentage "
"(for example 200%), it will be computed over nozzle diameter or layer "
"height, depending on the 'Percentages relative to nozzle size' setting."
msgstr ""
"设为非零值可手动设置外轮廓的挤出宽度。若保持为零，将使用默认挤出宽度（若已设"
"置），否则使用 1.125 倍喷嘴直径。若以百分比表示（例如 200%），将根据“相对于喷"
"嘴尺寸的百分比”设置，以喷嘴直径或层高为基准计算。"

#: src/luminary/config/catalog/PrintConfig.cpp:1366
msgid ""
"This separate setting will affect the speed of external perimeters (the "
"visible ones). If expressed as percentage (for example: 80%) it will be "
"calculated on the perimeters speed setting above. Set to zero for auto."
msgstr ""
"此单独的设置将影响外部轮廓（可见轮廓）的速度。如果以百分比表示（例如：80%）它"
"将在上述周界速度设置上计算。为自动设置为零。"

#: src/luminary/config/catalog/PrintConfig.cpp:1376
msgid "External perimeters first"
msgstr "首先打印外部轮廓"

#: src/luminary/config/catalog/PrintConfig.cpp:1378
msgid ""
"Print contour perimeters from the outermost one to the innermost one instead "
"of the default inverse order."
msgstr "将轮廓周长从最外层的轮廓打印到最里面的轮廓，而不是默认的反向顺序。"

#: src/luminary/config/catalog/PrintConfig.cpp:1384
msgid "Extra perimeters if needed"
msgstr "如果需要，打印额外轮廓"

#: src/luminary/config/catalog/PrintConfig.cpp:1386
msgid ""
"Add more perimeters when needed for avoiding gaps in sloping walls. "
"preFlight keeps adding perimeters until more than 70% of the loop "
"immediately above is supported."
msgstr ""
"在需要时添加更多轮廓以避免倾斜壁出现间隙。preFlight 会不断添加轮廓，直到正上"
"方环路的 70% 以上得到支撑。"

#: src/luminary/config/catalog/PrintConfig.cpp:1393
msgid "Extra perimeters on overhangs (Experimental)"
msgstr "悬挑上的额外周长（实验）"

#: src/luminary/config/catalog/PrintConfig.cpp:1395
msgid ""
"Detect overhang areas where bridges cannot be anchored, and fill them with "
"extra perimeter paths. These paths are anchored to the nearby non-overhang "
"area when possible."
msgstr ""
"检测桥梁不能被锚定的悬空区域，用额外的周边路径来填补它们。在可能的情况下，这"
"些路径会被锚定在附近的非悬空区域。"

