msgstr "螺旋花瓶模式与顶部实心层不兼容"

#: src/luminary/config/catalog/PrintConfig.cpp:6590
msgid "Spiral vase mode is not compatible with support material"
msgstr "螺旋花瓶模式与支撑材料不兼容"

