msgstr "整个打印过程中每个挤出机挤出的耗材总体积。"

#: src/libslic3r/PrintConfig.cpp:8002 src/libslic3r/PrintConfig.cpp:8010
msgid "Print time (normal mode)"
msgstr "打印时间（正常模式）"

#: src/libslic3r/PrintConfig.cpp:8003
