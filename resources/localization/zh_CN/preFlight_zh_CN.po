#: src/luminary/config/catalog/PrintConfig.cpp:664
msgid "Bed temperature"
msgstr "热床温度"

#. TRN: Label of a configuration parameter: Nominal chamber temperature.
#: src/luminary/config/catalog/PrintConfig.cpp:671
msgid "Nominal"
msgstr "标称"

#: src/luminary/config/catalog/PrintConfig.cpp:672
msgid "Chamber temperature"
msgstr "腔体温度"

#: src/luminary/config/catalog/PrintConfig.cpp:673
msgid ""
"Required chamber temperature for the print.\n"
"When set to zero, the nominal chamber temperature is not set in the G-code."
msgstr ""
"打印所需的腔体温度。\n"
"设为零时，G-code 中不设置标称腔体温度。"

#. TRN: Label of a configuration parameter: Minimal chamber temperature
#: src/luminary/config/catalog/PrintConfig.cpp:683
#: src/luminary/config/catalog/PrintConfig.cpp:2292
#: src/luminary/config/catalog/PrintConfig.cpp:2310
#: src/luminary/config/catalog/PrintConfig.cpp:3645
msgid "Minimal"
msgstr "最小"

#: src/luminary/config/catalog/PrintConfig.cpp:684
msgid "Chamber minimal temperature"
msgstr "腔体最低温度"

#: src/luminary/config/catalog/PrintConfig.cpp:685
msgid ""
"Minimal chamber temperature that the printer waits for before the print "
"starts. This allows to start the print before the nominal chamber "
"temperature is reached.\n"
"When set to zero, the minimal chamber temperature is not set in the G-code."
msgstr ""
"打印开始前打印机等待达到的最低腔体温度。这样可在达到标称腔体温度之前开始打"
"印。\n"
"设为零时，G-code 中不设置最低腔体温度。"

#: src/luminary/config/catalog/PrintConfig.cpp:695
msgid "Bed temperature by extruder"
msgstr "按挤出机设定热床温度"

#: src/luminary/config/catalog/PrintConfig.cpp:696
