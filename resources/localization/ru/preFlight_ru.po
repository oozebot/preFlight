#: src/luminary/config/catalog/PrintConfig.cpp:6795
msgid "Export 3MF"
msgstr "Экспорт в 3MF"

#: src/luminary/config/catalog/PrintConfig.cpp:6796
msgid "Export the model(s) as 3MF."
msgstr "Экспортировать модель(и) в формат 3MF."

#: src/luminary/config/catalog/PrintConfig.cpp:6803
msgid "Slice"
msgstr "Нарезать"

#: src/luminary/config/catalog/PrintConfig.cpp:6804
msgid "Slice the model and export the result."
msgstr "Нарезать модель и экспортировать результат."

#: src/luminary/config/catalog/PrintConfig.cpp:6809
#: src/DSKY/GUI/KBShortcutsDialog.cpp:118 src/DSKY/GUI/ModernTabBar.cpp:949
#: src/DSKY/GUI/ModernTabBar.cpp:1102 src/DSKY/GUI/ModernTabBar.cpp:1136
