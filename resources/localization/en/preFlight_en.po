#: src/libslic3r/PrintConfig.cpp:3184 src/libslic3r/PrintConfig.cpp:3195
#: src/slic3r/GUI/Sidebar.cpp:2028 src/slic3r/GUI/Sidebar.cpp:6780
msgid "Max volumetric flow"
msgstr ""

#: src/libslic3r/PrintConfig.cpp:1641 src/libslic3r/PrintConfig.cpp:1652
msgid ""
"Maximum volumetric flow (mm³/s) this filament can sustain. Used by Auto "
"speed to calculate print move speeds. Also caps all print speeds regardless "
"of Auto speed."
msgstr ""

