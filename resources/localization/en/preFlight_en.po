#: src/DSKY/GUI/Preferences.cpp:1027
msgid "8x"
msgstr ""

#: src/DSKY/GUI/Preferences.cpp:1028
msgid "16x"
msgstr ""

#: src/DSKY/GUI/Preferences.cpp:1040
msgid "Supersampling (SSAA)"
msgstr ""

#: src/DSKY/GUI/Preferences.cpp:1041
msgid ""
"Renders the 3D scene at a higher resolution and downsamples it, reducing the "
"aliasing bands visible in dense G-code previews. Sharper than MSAA but "
"considerably more demanding; intended for powerful GPUs. While enabled it "
"supersedes MSAA for the scene. Takes effect immediately."
msgstr ""

#: src/DSKY/GUI/Preferences.cpp:1046
msgid "1.5x"
msgstr ""

#: src/DSKY/GUI/Preferences.cpp:1058
msgid "Preview Detail"
msgstr ""

#: src/DSKY/GUI/Preferences.cpp:1059
msgid ""
"Controls how much detail is computed for the G-code preview on large prints. "
"Lower values reduce memory usage and speed up slicing at the cost of less "
"detailed preview data. Does not affect print output, G-code, or time "
"estimation."
msgstr ""

