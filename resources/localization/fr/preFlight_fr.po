msgstr ""
"Serpentine a généré %1% région(s) avec des parois ordinaires car le motif "
"n'a pas pu y être appliqué (trop fine ou trop complexe). Passez en revue les "
"trajets du Périmètre externe dans l'Aperçu."

#: src/luminary/pipeline/object/PrintObject.cpp:392
#: src/luminary/pipeline/object/PrintObject.cpp:540
msgid "Preparing infill"
msgstr "Préparation du remplissage"

#: src/luminary/pipeline/object/PrintObject.cpp:658
msgid "Making infill"
msgstr "Définition du remplissage"

#: src/luminary/pipeline/object/PrintObject.cpp:762
msgid "Searching support spots"
msgstr "Recherche des points de support"

#: src/luminary/pipeline/object/PrintObject.cpp:813
msgid "Generating support material"
msgstr "Génération des supports"

