#: src/libslic3r/PrintConfig.cpp:454
msgid ""
"Picture sizes to be stored into a .gcode / .bgcode and .sl1 / .sl1s files, "
"in the following format: \"XxY/EXT, XxY/EXT, ...\"\n"
"Currently supported extensions are PNG, QOI, JPG, BTT_TFT and COLPIC."
msgstr ""
"Tailles des images à stocker dans les fichiers .gcode / .bgcode "
"et .sl1 / .sl1s, au format suivant : \"XxY/EXT, XxY/EXT, ...\"\n"
"Les extensions actuellement prises en charge sont PNG, QOI, JPG, BTT_TFT et "
"COLPIC."

#: src/libslic3r/PrintConfig.cpp:461
msgid "Format of G-code thumbnails"
msgstr "Format des vignettes du G-code"

#: src/libslic3r/PrintConfig.cpp:463
