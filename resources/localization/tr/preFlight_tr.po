msgstr "mm veya %"

#: src/libslic3r/PrintConfig.cpp:696 src/libslic3r/PrintConfig.cpp:5071
msgid "Other layers"
msgstr "Diğer katmanlar"

#: src/libslic3r/PrintConfig.cpp:697
msgid ""
"Bed temperature for layers after the first one. Set this to zero to keep the "
"first layer bed temperature for the entire print."
msgstr ""
"İlkinden sonraki katmanlar için tabla sıcaklığı. Tüm baskı boyunca ilk "
"katman tabla sıcaklığını korumak için bunu sıfıra ayarlayın."

#: src/libslic3r/PrintConfig.cpp:699 src/libslic3r/PrintConfig.cpp:711
#: src/libslic3r/PrintConfig.cpp:724 src/libslic3r/PrintConfig.cpp:2072
#: src/libslic3r/PrintConfig.cpp:2151 src/libslic3r/PrintConfig.cpp:5074
