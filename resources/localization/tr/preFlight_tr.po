#: src/libslic3r/PrintConfig.cpp:1015
msgid "Over bridges"
msgstr "Köprülerin üzerinde"

#: src/libslic3r/PrintConfig.cpp:1017
msgid ""
"Speed for printing solid infill above bridges. Set to 0 to use solid infill "
"speed. If set as percentage, the speed is calculated over solid infill speed."
msgstr ""
"Köprülerin üzerindeki dolu dolguyu baskı hızı. Dolu dolgu hızını kullanmak "
"için 0 olarak ayarlayın. Yüzde olarak ayarlanırsa, hız dolu dolgu hızı "
"üzerinden hesaplanır."

