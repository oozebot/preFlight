#: src/luminary/layer/settings_spec/SettingsSpec.cpp:281
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:284
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:286
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:288
