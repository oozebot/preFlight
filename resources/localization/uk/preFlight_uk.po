#: src/luminary/config/catalog/PrintConfig.cpp:598
msgid "Auto extrusion widths"
msgstr "Автоматична ширина екструзії"

#: src/luminary/config/catalog/PrintConfig.cpp:599
#: src/luminary/config/catalog/PrintConfig.cpp:926
#: src/luminary/config/catalog/PrintConfig.cpp:1352
