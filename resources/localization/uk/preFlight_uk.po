#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1199
msgid ""
"Number of solid layers to generate on top and bottom surfaces. These layers "
"provide a finished appearance and structural support for the printed object."
msgstr ""
"Кількість суцільних шарів для генерації на верхніх і нижніх поверхнях. Ці "
"шари забезпечують завершений вигляд і структурну підтримку для надрукованого "
"об'єкта."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1201
msgid ""
"Minimum thickness (in mm) of top and bottom shells. The layer count will be "
"automatically increased if needed to meet this thickness, which helps "
"prevent pillowing on top surfaces when using variable layer heights."
msgstr ""
"Мінімальна товщина (в мм) верхніх і нижніх оболонок. Кількість шарів буде "
"автоматично збільшено за потреби для досягнення цієї товщини, що допомагає "
"запобігти провисанню на верхніх поверхнях під час використання змінної "
"висоти шару."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1203
msgid ""
"Number of solid layers between interlocking perimeters and visible surfaces. "
"Ensures the interlocking pattern is fully hidden inside the object."
msgstr ""
"Кількість суцільних шарів між зчеплюваними периметрами та видимими "
"поверхнями. Гарантує, що візерунок зчеплення повністю прихований усередині "
"об'єкта."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1400
msgid "Available with at least one perimeter."
msgstr "Доступно з принаймні одним периметром."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1403
msgid ""
"Available with at least one perimeter and a seam type other than Regular."
msgstr ""
"Доступно з принаймні одним периметром і типом шва, відмінним від Звичайний."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1406
msgid "Available when dynamic overhang speeds are enabled."
msgstr "Доступно за ввімкненої динамічної швидкості нависань."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1408
msgid "Available with a fill density above 0%."
msgstr "Доступно зі щільністю заповнення вище 0%."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1411
msgid "Available with infill, when automatic infill combination is disabled."
msgstr ""
"Доступно із заповненням, якщо автоматична комбінація заповнення вимкнена."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1414
msgid "Available with infill, when automatic infill combination is enabled."
msgstr ""
"Доступно із заповненням, якщо автоматична комбінація заповнення ввімкнена."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1417
msgid "Available with infill and a maximum infill anchor length above 0."
msgstr ""
"Доступно із заповненням і максимальною довжиною якоря заповнення вище 0."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1419
msgid "Available with top or bottom solid layers."
msgstr "Доступно з верхніми або нижніми суцільними шарами."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1421
msgid "Available with infill or solid layers."
msgstr "Доступно із заповненням або суцільними шарами."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1423
msgid "Available when Narrow to Athena is enabled."
msgstr "Доступно за ввімкненого \"Звузити до Athena\"."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1431
msgid ""
"Available with top solid layers and Ensure vertical shell thickness, without "
"spiral vase."
msgstr ""
"Доступно з верхніми суцільними шарами і \"Гарантована товщина вертикальної "
"оболонки\", без спіральної вази."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1439
msgid ""
"Available with bottom solid layers and Ensure vertical shell thickness, "
"without spiral vase."
msgstr ""
"Доступно з нижніми суцільними шарами і \"Гарантована товщина вертикальної "
"оболонки\", без спіральної вази."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1441
msgid ""
"Disabled while Auto speed is active; it sets this speed from the maximum "
"print speed and the volumetric flow."
msgstr ""
"Недоступно, поки автошвидкість активна; вона обчислює цю швидкість з "
"максимальної швидкості друку та об'ємного потоку."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1444
msgid "Available with top solid layers, while Auto speed is not active."
msgstr "Доступно з верхніми суцільними шарами, поки автошвидкість не активна."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1447
msgid ""
"Available with support material and interface layers, while Auto speed is "
"not active."
msgstr ""
"Доступно з підтримкою і сполучними шарами, поки автошвидкість не активна."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1450
msgid "Available with a fuzzy skin noise type other than Classic."
msgstr "Доступно з типом шуму нечіткої поверхні, відмінним від Classic."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1453
msgid "Available with the Perlin, Billow or Ridged fuzzy skin noise."
msgstr "Доступно з шумом нечіткої поверхні Perlin, Billow або Ridged."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1456
msgid "Available with the Perlin or Billow fuzzy skin noise."
msgstr "Доступно з шумом нечіткої поверхні Perlin або Billow."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1458
msgid "Disabled while Spiral vase is active."
msgstr "Недоступно, поки спіральна ваза активна."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1460
msgid "Available when Serpentine is enabled."
msgstr "Доступно за ввімкненого Serpentine."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1463
msgid "Available when Serpentine and relaxed spacing are enabled."
msgstr "Доступно за ввімкнених Serpentine і вільного інтервалу."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1465
msgid "Available when Serpentine is enabled and relaxed spacing is disabled."
msgstr "Доступно за ввімкненого Serpentine і вимкненого вільного інтервалу."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1468
msgid ""
"Available when Serpentine and its depth limit are enabled and relaxed "
"spacing is disabled."
msgstr ""
"Доступно за ввімкнених Serpentine і обмеження глибини та вимкненого вільного "
"інтервалу."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1471
msgid ""
"Available when Serpentine is enabled and relaxed spacing and the outer loop "
"are disabled; the outer loop aligns the ridges itself."
msgstr ""
"Доступно за ввімкненого Serpentine та вимкнених вільного інтервалу і "
"зовнішньої петлі; зовнішня петля сама вирівнює гребені."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1474
msgid "Available when interlocking perimeters are enabled."
msgstr "Доступно за ввімкнених зчеплюваних периметрів."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1477
msgid "Available with a top surface flow reduction above 0%."
msgstr "Доступно зі зменшенням потоку верхньої поверхні вище 0%."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1479
msgid "Available with top solid layers."
msgstr "Доступно з верхніми суцільними шарами."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1482
msgid ""
"Available with a default acceleration above 0; at 0 the firmware's "
"acceleration is left alone."
msgstr ""
"Доступно з прискоренням за замовчуванням вище 0; при 0 прискорення прошивки "
"залишається без змін."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1483
msgid "Available with at least one skirt loop."
msgstr "Доступно з принаймні однією петлею смуги."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1486
msgid ""
"Available with a skirt, while the draft shield is not enabled; an enabled "
"draft shield sets the height itself."
msgstr ""
"Доступно зі смугою, поки захисний кожух не ввімкнений; ввімкнений захисний "
"кожух сам задає висоту."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1489
msgid "Available when support material or a raft is enabled."
msgstr "Доступно за ввімкненої підтримки або підкладки."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1491
msgid ""
"Available when supports are generated automatically; painted supports carry "
"this in the paint."
msgstr ""
"Доступно, якщо підтримки створюються автоматично; розфарбовані підтримки "
"несуть це в розфарбуванні."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1498
msgid "Available with supports and a custom top contact Z distance."
msgstr "Доступно з підтримками і власним зазором зверху за віссю Z."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1505
msgid "Available with supports and a half-layer bottom contact Z distance."
msgstr "Доступно з підтримками і зазором знизу за віссю Z у половину шару."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1507
msgid ""
"Available when support material is enabled or support enforcers are painted."
msgstr ""
"Доступно за ввімкненої підтримки або розфарбованих примусових підтримок."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1509
msgid "Available with support material and interface layers."
msgstr "Доступно з підтримкою і сполучними шарами."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1511
msgid "Available when support material, a raft or a skirt is enabled."
msgstr "Доступно за ввімкнених підтримки, підкладки або смуги."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1513
msgid "Available with raft layers and a top contact Z distance above 0."
msgstr "Доступно з шарами підкладки і зазором зверху за віссю Z вище 0."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1514
msgid "Available with at least one raft layer."
msgstr "Доступно з принаймні одним шаром підкладки."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1516
msgid "Available when ironing is enabled."
msgstr "Доступно за ввімкненого прасування."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1518
msgid "Available when ooze prevention is enabled."
msgstr "Доступно за ввімкненого запобігання просочування."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1520
msgid "Available when the wipe tower is enabled."
msgstr "Доступно за ввімкненої вежі очищення."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1523
msgid ""
"Disabled while Avoid crossing perimeters is active; the two are exclusive."
msgstr ""
"Недоступно, поки активне \"Уникати перетинання периметрів\"; ці дві опції "
"взаємовиключні."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1526
msgid ""
"Disabled while Avoid crossing curled overhangs is active; the two are "
"exclusive."
msgstr ""
"Недоступно, поки активне \"Уникати перетинів на вигнутих нависаннях\"; ці "
"дві опції взаємовиключні."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1529
msgid "Available when Avoid crossing perimeters is enabled."
msgstr "Доступно за ввімкненого \"Уникати перетинання периметрів\"."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1532
msgid "Available with the Arachne or Athena perimeter generator."
msgstr "Доступно з генератором периметрів Arachne або Athena."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1534
msgid ""
"Available with the Arachne perimeter generator; Athena keeps its widths "
"fixed."
msgstr ""
"Доступно з генератором периметрів Arachne; Athena зберігає свою ширину "
"незмінною."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1536
msgid "Available with the Athena perimeter generator."
msgstr "Доступно з генератором периметрів Athena."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1543
msgid ""
"Available with a scarf seam placement other than Nowhere, without spiral "
"vase."
msgstr ""
"Доступно з розташуванням косого шва, відмінним від Ніде, без спіральної вази."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1545
msgid "Available when interlocking beams are enabled."
msgstr "Доступно за ввімкненого блокування балок."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1547
msgid ""
"Disabled while interlocking beams are active; they replace the segmented "
"regions."
msgstr ""
"Недоступно, поки блокування балок активне; воно замінює сегментовані області."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1550
msgid ""
"Available with a segmented region width above 0, while interlocking beams "
"are not active."
msgstr ""
"Доступно з шириною сегментованої області вище 0, поки блокування балок не "
"активне."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1553
msgid ""
"Disabled while manual fan speeds are active; they set the fan per feature."
msgstr ""
"Недоступно, поки активні ручні швидкості вентилятора; вони задають "
"вентилятор для кожного елемента."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1555
msgid "Available when automatic cooling is enabled."
msgstr "Доступно за ввімкненого автоматичного охолодження."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1558
msgid ""
"Available when automatic cooling or the fan always on is enabled, while "
"manual fan speeds are not active."
msgstr ""
"Доступно за ввімкненого автоматичного охолодження або постійно ввімкненого "
"вентилятора, поки ручні швидкості вентилятора не активні."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1561
msgid "Available when manual fan speeds are enabled."
msgstr "Доступно за ввімкнених ручних швидкостей вентилятора."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1564
msgid ""
"Available when dynamic fan speeds are enabled, while manual fan speeds are "
"not active."
msgstr ""
"Доступно за ввімкненої динамічної швидкості вентилятора, поки ручні "
"швидкості вентилятора не активні."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1573
msgid ""
"Available when automatic cooling uses the Consistent surface slowdown logic."
msgstr ""
"Доступно, якщо автоматичне охолодження використовує логіку уповільнення "
"\"Постійна поверхня\"."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1576
msgid "Available when multitool ramming is enabled."
msgstr "Доступно за ввімкненого раммінгу кількома інструментами."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1579
msgid "Available when pressure advance is enabled for this filament."
msgstr "Доступно за ввімкненого pressure advance для цього філаменту."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1582
msgid "Available with more than one extruder."
msgstr "Доступно з більш ніж одним екструдером."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1584
msgid "Available with a Marlin firmware flavor."
msgstr "Доступно з різновидом прошивки Marlin."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1586
msgid ""
"Available when the machine limits are in use, for the time estimate or "
"emitted to G-code."
msgstr ""
"Доступно, якщо використовуються обмеження принтера, для оцінки часу або "
"виведення в G-code."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1588
msgid ""
"Available when the machine limits are in use, with a Marlin firmware flavor; "
"only Marlin has minimum feedrates."
msgstr ""
"Доступно, якщо використовуються обмеження принтера, з різновидом прошивки "
"Marlin; лише Marlin має мінімальні швидкості подачі."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1596
msgid ""
"Available when the machine limits are in use, with a firmware that has a "
"travel acceleration (Marlin 2, RepRapFirmware, Rapid)."
msgstr ""
"Доступно, якщо використовуються обмеження принтера, з прошивкою з "
"прискоренням переміщення (Marlin 2, RepRapFirmware, Rapid)."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1599
msgid ""
"Disabled while firmware retraction is active; the firmware performs the "
"retraction itself."
msgstr ""
"Недоступно, поки активний відкат із прошивки; прошивка виконує відкат сама."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1601
msgid "Disabled while ramping lift is active; it replaces the fixed lift."
msgstr ""
"Недоступно, поки активний підйом під кутом; він замінює фіксований підйом."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1603
msgid "Available when ramping lift is enabled."
msgstr "Доступно за ввімкненого підйому під кутом."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1605
msgid "Available with a retraction length above 0 or firmware retraction."
msgstr "Доступно з довжиною відкату вище 0 або відкатом із прошивки."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1612
msgid ""
"Available with a lift: a retract lift above 0, or ramping lift with a "
"maximum lift above 0."
msgstr ""
"Доступно з підйомом: висотою підйому вище 0, або підйомом під кутом з "
"висотою похилого підйому вище 0."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1614
msgid ""
"Available with a retraction length above 0, while firmware retraction is not "
"active."
msgstr ""
"Доступно з довжиною відкату вище 0, поки відкат із прошивки не активний."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1616
msgid ""
"Available when wipe while retracting is enabled, while firmware retraction "
"is not active."
msgstr ""
"Доступно за ввімкненого очищення сопла при відкаті, поки відкат із прошивки "
"не активний."

#: src/luminary/layer/settings_spec/SettingsSpec.cpp:1619
msgid ""
"Available with more than one extruder and a retraction length above 0 when "
"the tool is disabled."
msgstr ""
"Доступно з більш ніж одним екструдером і довжиною відкату вище 0, коли "
"інструмент вимкнений."

#: src/luminary/pipeline/object/PrintObject.cpp:228
msgid "Generating perimeters"
msgstr "Створення периметрів"

#: src/luminary/pipeline/object/PrintObject.cpp:366
#, boost-format
msgid ""
"Serpentine generated %1% region(s) with ordinary walls because the pattern "
"could not be hosted there (too thin or too intricate). Review the External "
"perimeter paths in Preview."
msgstr ""
"Serpentine згенерував %1% області звичайними стінками, бо візерунок не "
"вдалося розмістити там (занадто тонка або занадто складна). Перегляньте "
"шляхи Зовнішнього периметра в Перегляді Нарізки."

#: src/luminary/pipeline/object/PrintObject.cpp:392
#: src/luminary/pipeline/object/PrintObject.cpp:540
msgid "Preparing infill"
msgstr "Підготовка заповнення"

#: src/luminary/pipeline/object/PrintObject.cpp:658
msgid "Making infill"
msgstr "Створення заповнення"

#: src/luminary/pipeline/object/PrintObject.cpp:762
msgid "Searching support spots"
msgstr "Пошук точок підтримки"

#: src/luminary/pipeline/object/PrintObject.cpp:813
msgid "Generating support material"
msgstr "Генерація підтримок"

#: src/luminary/pipeline/object/PrintObject.cpp:852
#, boost-format
msgid ""
"An extrusion width of %1% mm (%2%%% of the nozzle diameter) exceeds the "
"width warning maximum of %3%%%, at z = %4% mm."
msgstr ""
"Ширина екструзії %1% мм (%2%%% діаметра сопла) перевищує максимум "
"попередження ширини %3%%%, при z = %4% мм."

#: src/luminary/pipeline/object/PrintObject.cpp:877
msgid "Estimating curled extrusions"
msgstr "Оцінювання вигнутих екструзій"

#: src/luminary/pipeline/object/PrintObject.cpp:930
msgid "Calculating overhanging perimeters"
msgstr "Розрахунок нависаючих периметрів"

#: src/luminary/pipeline/print/Print.cpp:531
msgid ""
"Draft shield is enabled but Skirt loops is 0, so no draft shield is printed."
msgstr ""
"Захисний кожух увімкнено, але кількість петель смуги дорівнює 0, тому "
"захисний кожух не друкується."

#: src/luminary/pipeline/print/Print.cpp:643
msgid "All objects are outside of the print volume."
msgstr "Усі об'єкти знаходяться за межами області друку."

#: src/luminary/pipeline/print/Print.cpp:646
msgid "The supplied settings will cause an empty print."
msgstr "Надані параметри спричинять порожній друк."

#: src/luminary/pipeline/print/Print.cpp:686
msgid ""
"Auto speed requires every filament to have a Max volumetric flow set. Check "
"your Filament Settings."
msgstr ""
"Автоматична швидкість потребує, щоб для кожної нитки було задано "
"максимальний об'ємний потік. Перевірте налаштування нитки."

#: src/luminary/pipeline/print/Print.cpp:698
msgid "Ironing speed cannot be 0. Set an explicit speed or disable ironing."
msgstr ""
"Швидкість прасування не може бути 0. Задайте явну швидкість або вимкніть "
"прасування."

#: src/luminary/pipeline/print/Print.cpp:705
msgid ""
"Avoid crossing perimeters option and avoid crossing curled overhangs option "
"cannot be both enabled together."
msgstr ""
"Параметр 'Уникати перетину периметрів' і 'Уникати перетину на вигнутих "
"нависаннях' не можуть бути включені одночасно."

#: src/luminary/pipeline/print/Print.cpp:715
msgid ""
"Only a single object may be printed at a time in Spiral Vase mode. Either "
"remove all but the last object, or enable sequential mode by "
"\"complete_objects\"."
msgstr ""
"Режим 'Спіральна Ваза' може використовуватися для друку тільки одного "
"об'єкта. \n"
"Або залиште на столі один об'єкт, або увімкніть послідовний друк за "
"допомогою 'Друкувати об'єкти по черзі'(\"complete_objects\")."

#: src/luminary/pipeline/print/Print.cpp:719
msgid ""
"The Spiral Vase option can only be used when printing single material "
"objects."
msgstr "У режимі 'Спіральна Ваза' можна друкувати тільки одним матеріалом."

#: src/luminary/pipeline/print/Print.cpp:724
msgid ""
"With absolute extruder addressing, Spiral Vase mode does not taper its first "
"and last layer and does not blend layers in XY. Enable \"Use relative E "
"distances\" in Printer Settings to get both, if your firmware supports it."
msgstr ""
"За абсолютної адресації екструдера режим Спіральна ваза не звужує перший і "
"останній шар та не змішує шари по осях XY. Увімкніть \"Використовувати "
"відносні E відстані\" в Налаштуваннях принтера, щоб отримати обидва ефекти, "
"якщо ваша прошивка це підтримує."

#: src/luminary/pipeline/print/Print.cpp:730
msgid ""
"Machine limits cannot be emitted to G-Code when Klipper firmware flavor is "
"used. Change the value of machine_limits_usage."
msgstr ""
"Прошивка Klipper не підтримує встановлення обмежень принтера. Змініть "
"значення параметра 'Обмеження принтера'(machine_limits_usage)."

#: src/luminary/pipeline/print/Print.cpp:766
#, boost-format
msgid ""
"While the object %1% itself fits the build volume, it exceeds the maximum "
"build volume height because of material shrinkage compensation."
msgstr ""
"Незважаючи на те, що об'єкт %1% сам по собі поміщається в область друку, "
"після застосування компенсації усадки він перестає поміщатися."

#: src/luminary/pipeline/print/Print.cpp:772
#, boost-format
msgid "The object %1% exceeds the maximum build volume height."
msgstr "Висота об'єкта %1% перевищує максимально допустиму область друку."

#: src/luminary/pipeline/print/Print.cpp:780
#, boost-format
msgid ""
"While the object %1% itself fits the build volume, its last layer exceeds "
"the maximum build volume height."
msgstr ""
"Хоча сама модель %1% вписується в область друку, її останній шар перевищує "
"максимальну висоту області друку."

#: src/luminary/pipeline/print/Print.cpp:784
msgid ""
"You might want to reduce the size of your model or change current print "
"settings and retry."
msgstr ""
"Спробуйте зменшити розмір моделі або змінити поточні налаштування друку та "
"повторити спробу."

#: src/luminary/pipeline/print/Print.cpp:836
#, boost-format
msgid ""
"Variable layer height regions thicker than %1% mm are not supported with the "
"current support settings."
msgstr ""
"Ділянки зі змінною висотою шару товщиною понад %1% мм не підтримуються за "
"поточних налаштувань підтримок."

#: src/luminary/pipeline/print/Print.cpp:861
msgid ""
"The wipe tower is only supported if all extruders use filaments of the same "
"diameter."
msgstr ""
"Режим 'Вежі Очищення' застосовний тільки в тому разі, якщо всі екструдери "
"мають однаковий діаметр сопла і використовується філамент одного діаметра."

#: src/luminary/pipeline/print/Print.cpp:870
msgid ""
"The Wipe Tower is currently only supported for the oozeBot Rapid, Marlin, "
"Klipper, RepRap/Sprinter, RepRapFirmware and Repetier G-code flavors."
msgstr ""
"Вежа очищення наразі підтримується лише для діалектів G-code oozeBot Rapid, "
"Marlin, Klipper, RepRap/Sprinter, RepRapFirmware та Repetier."

#: src/luminary/pipeline/print/Print.cpp:873
msgid ""
"The Wipe Tower is currently only supported with the relative extruder "
"addressing (use_relative_e_distances=1)."
msgstr ""
"Наразі 'Вежа Очищення' підтримує лише відносну адресацію екструдерів "
"(use_relative_e_distances = 1)."

#: src/luminary/pipeline/print/Print.cpp:876
msgid ""
"Ooze prevention is only supported with the wipe tower when "
"'single_extruder_multi_material' is off."
msgstr ""
"Запобігання течі матеріалу за допомогою 'Вежі Очищення' підтримується тільки "
"коли параметр 'Одно-екструдерний багато-кольоровий принтер' "
"('single_extruder_multi_material') вимкнено."

#: src/luminary/pipeline/print/Print.cpp:878
msgid ""
"The Wipe Tower currently does not support volumetric E (use_volumetric_e=0)."
msgstr "Наразі 'Вежа Очищення' не підтримує об'ємне E (use_volumetric_e = 0)."

#: src/luminary/pipeline/print/Print.cpp:880
msgid ""
"The Wipe Tower is currently not supported for multimaterial sequential "
"prints."
msgstr ""
"Наразі 'Вежа Очищення' не підтримується для багато-кольорового послідовного "
"друку."

#: src/luminary/pipeline/print/Print.cpp:894
msgid ""
"The Wipe Tower is not supported when supports are combined with variable "
"layer height."
msgstr ""
"'Вежа Очищення' не підтримується, якщо підтримки поєднуються зі змінною "
"висотою шару."

#: src/luminary/pipeline/print/Print.cpp:908
msgid ""
"The Wipe Tower is only supported for multiple objects if they have equal "
"layer heights"
msgstr ""
"'Вежа Очищення' для кількох об’єктів підтримується лише у випадку, коли вони "
"мають однакову висоту шару"

#: src/luminary/pipeline/print/Print.cpp:911
msgid ""
"The Wipe Tower is only supported for multiple objects if they are printed "
"over an equal number of raft layers"
msgstr ""
"'Вежа Очищення' витирання для кількох об’єктів підтримується лише у випадку, "
"коли вони надруковані на рівній кількості шарів підкладки"

#: src/luminary/pipeline/print/Print.cpp:915
msgid ""
"The Wipe Tower is only supported for multiple objects if they are printed "
"with the same support_material_contact_distance"
msgstr ""
"'Вежу Очищення' можна застосувати для декількох моделей тільки в тому разі, "
"якщо вони друкуються з однаковим support_material_contact_distance (відстань "
"від підтримки до об'єкта по вертикалі)"

#: src/luminary/pipeline/print/Print.cpp:917
msgid ""
"The Wipe Tower is only supported for multiple objects if they are sliced "
"equally."
msgstr ""
"'Вежа Очищення' витирання для кількох об’єктів підтримується лише у випадку, "
"коли вони нарізані однаково."

#: src/luminary/pipeline/print/Print.cpp:950
msgid ""
"The Wipe tower is only supported if all objects have the same variable layer "
"height"
msgstr ""
"'Вежа Очищення' підтримується лише в тому випадку, якщо всі об’єкти мають "
"однакову висоту змінного шару"

#: src/luminary/pipeline/print/Print.cpp:984
#, boost-format
msgid "%1%=%2% mm is too low to be printable at a layer height %3% mm"
msgstr "%1%=%2% мм є занадто низьким для друку на висоті шару %3% мм"

#: src/luminary/pipeline/print/Print.cpp:991
#, boost-format
msgid "Excessive %1%=%2% mm to be printable with a nozzle diameter %3% mm"
msgstr "%1% = %2% мм є надмірно для друку з діаметром сопла %3% мм"

#: src/luminary/pipeline/print/Print.cpp:1023
#: src/DSKY/GUI/ConfigManipulation.cpp:690
msgid ""
"The Wipe Tower currently supports the non-soluble supports only if they are "
"printed with the current extruder without triggering a tool change. (both "
"support_material_extruder and support_material_interface_extruder need to be "
"set to 0)."
msgstr ""
"Наразі режим 'Вежі Очищення' підтримує нерозчинну підтримку тільки в тому "
"випадку, якщо вони друкуються поточним екструдером, без запуску зміни "
"інструменту. (Значення 'Екструдер, що друкує підтримки/підкладки/смугу' і "
"'Екструдер для Прокладки (сполучний шар) підтримки/підкладки' повинні бути "
"встановлені в 0)."

#: src/luminary/pipeline/print/Print.cpp:1044
msgid ""
"Organic support tree tip diameter must not be smaller than support material "
"extrusion width."
msgstr ""
"Діаметр вершини гілки органічної підтримки не повинен бути меншим за "
"значення ширини екструзії підтримки."

#: src/luminary/pipeline/print/Print.cpp:1047
msgid ""
"Organic support branch diameter must not be smaller than 2x support material "
"extrusion width."
msgstr ""
"Діаметр гілки органічної підтримки має бути хоча б удвічі більшим за "
"значення ширини екструзії підтримки."

#: src/luminary/pipeline/print/Print.cpp:1049
msgid ""
"Organic support branch diameter must not be smaller than support tree tip "
"diameter."
msgstr ""
"Діаметр гілок органічної підтримки має бути більшим за діаметр вершини гілки."

#: src/luminary/pipeline/print/Print.cpp:1054
msgid ""
"Baobab support trunk diameter must not be smaller than 2x support material "
"extrusion width."
msgstr ""
"Діаметр стовбура підтримки Баобаб має бути хоча б удвічі більшим за значення "
"ширини екструзії підтримки."

#: src/luminary/pipeline/print/Print.cpp:1095
msgid "First layer height can't be greater than nozzle diameter"
msgstr "Висота першого шару не може перевищувати діаметр сопла"

#: src/luminary/pipeline/print/Print.cpp:1100
msgid "Layer height can't be greater than nozzle diameter"
msgstr "Висота шару не може перевищувати діаметр сопла"

#: src/luminary/pipeline/print/Print.cpp:1134
msgid ""
"Relative extruder addressing requires resetting the extruder position at "
"each layer to prevent loss of floating point accuracy. Add \"G92 E0\" to "
"layer_gcode."
msgstr ""
"При відносній адресації екструдера його положення необхідно коригувати на "
"кожному шарі, щоб запобігти втраті точності з плаваючою комою. \n"
"Додайте \"G92 E0\" до G-коду, що виконується при зміні шару (layer_gcode)."

#: src/luminary/pipeline/print/Print.cpp:1138
msgid ""
"\"G92 E0\" was found in before_layer_gcode, which is incompatible with "
"absolute extruder addressing."
msgstr ""
"У G-коді, що виконується перед зміною шару (before_layer_gcode) було "
"знайдено команду \"G92 E0\", яка несумісна з абсолютною адресацією "
"екструдера."

#: src/luminary/pipeline/print/Print.cpp:1141
msgid ""
"\"G92 E0\" was found in layer_gcode, which is incompatible with absolute "
"extruder addressing."
msgstr ""
"У G-коді, що виконується під час зміни шару (layer_gcode) було знайдено "
"команду \"G92 E0\", яка несумісна з абсолютною адресацією екструдера."

#: src/luminary/pipeline/print/Print.cpp:1336
msgid "Generating skirt and brim"
msgstr "Генерація смуги та кромки"

#: src/luminary/pipeline/print/Print.cpp:1427
msgid "Exporting G-code"
msgstr "Експортування G-коду"

#: src/luminary/pipeline/print/Print.cpp:1432
msgid "Generating G-code"
msgstr "Генерування G-коду"

#: src/luminary/pipeline/print/Print.cpp:1440
msgid "Preparing preview data"
msgstr "Підготовка даних попереднього перегляду"

#: src/luminary/pipeline/print/Print.cpp:1695
msgid "Alert if supports needed"
msgstr "Попереджати, якщо необхідні підтримки"

#: src/luminary/pipeline/print/Print.cpp:1704
msgid "Long bridging extrusions"
msgstr "Екструзія довгих мостів"

#: src/luminary/pipeline/print/Print.cpp:1708
msgid "Floating bridge anchors"
msgstr "Прив'язки плаваючого мосту"

#. TRN Alert when support is needed. Describes that the print has large overhang area which will print badly or not print at all.
#: src/luminary/pipeline/print/Print.cpp:1714
msgid "Collapsing overhang"
msgstr "Падаюче нависання"

#. TRN Alert when support is needed. Describes extrusions that are not supported enough and come out curled or loose.
#: src/luminary/pipeline/print/Print.cpp:1719
msgid "Loose extrusions"
msgstr "Екструзія в повітря"

#: src/luminary/pipeline/print/Print.cpp:1724
msgid "Low bed adhesion"
msgstr "Слабка адгезія до столу"

#: src/luminary/pipeline/print/Print.cpp:1728
msgid "Floating object part"
msgstr "Частина деталі в повітрі"

#: src/luminary/pipeline/print/Print.cpp:1732
msgid "Thin fragile part"
msgstr "Тонка крихка частина"

# DrFOXUA: do not translate
#. TRN this translation rule is used to translate lists of uknown size on single line. The first argument is element of the list,
#. the second argument may be element or rest of the list. For most languages, this does not need translation, but some use different
#. separator than comma and some use blank space in front of the separator.
#: src/luminary/pipeline/print/Print.cpp:1742
#, boost-format
msgid "%1%, %2%"
msgstr "%1%, %2%"

#. TRN Alert header for geometry that needs supports. The argument is the list of detected issues.
#: src/luminary/pipeline/print/Print.cpp:1983
#, boost-format
msgid ""
"Detected unsupported geometry:\n"
"%1%"
msgstr ""
"Виявлено непідтримувану геометрію:\n"
"%1%"

#: src/luminary/pipeline/print/Print.cpp:1983
msgid "Consider enabling supports."
msgstr "Рекомендується ввімкнути підтримку."

#. TRN Alert advice when a part's bed adhesion is insufficient.
#: src/luminary/pipeline/print/Print.cpp:1987
msgid "Consider enabling a brim."
msgstr "Рекомендується ввімкнути кромку."

#. TRN Alert advice when a part is thin enough to break during printing.
#: src/luminary/pipeline/print/Print.cpp:1990
msgid "Consider thickening the part or adding perimeters."
msgstr "Рекомендується потовщити частину або додати периметри."

#. TRN Alert header for issues supports cannot fix: bed adhesion and fragile parts. The argument is the list of detected issues.
#: src/luminary/pipeline/print/Print.cpp:1992
#, boost-format
msgid ""
"Detected bed adhesion or part strength issues:\n"
"%1%"
msgstr ""
"Виявлено проблеми з адгезією до столу або міцністю частини:\n"
"%1%"

#: src/luminary/pipeline/slice/PrintObjectSlice.cpp:704
msgid "Preparing layers"
msgstr "Підготовка шарів"

#: src/luminary/pipeline/slice/PrintObjectSlice.cpp:715
