msgstr "Érvénytelen érték a --bridge-flow-ratio kapcsolóhoz"

#: src/luminary/config/catalog/PrintConfig.cpp:6556
msgid "Invalid value for --extruder-clearance-radius"
msgstr "Érvénytelen érték a --extruder-clearance-radius kapcsolóhoz"

#: src/luminary/config/catalog/PrintConfig.cpp:6558
msgid "Invalid value for --extruder-clearance-height"
msgstr "Érvénytelen érték a --extruder-clearance-height kapcsolóhoz"

#: src/luminary/config/catalog/PrintConfig.cpp:6563
