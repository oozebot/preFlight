#: src/slic3r/GUI/Gizmos/GLGizmoCut.cpp:2903
#: src/slic3r/GUI/LoadStepDialog.cpp:278
msgid "°"
msgstr "°"

#: src/libslic3r/PrintConfig.cpp:803
msgid "Counterbore bridge layers"
msgstr "Süllyesztett híd rétegei"

#: src/libslic3r/PrintConfig.cpp:804 src/slic3r/GUI/Sidebar.cpp:1759
msgid "Quality"
msgstr "Minőség"

#: src/libslic3r/PrintConfig.cpp:805
msgid ""
"Number of transition layers for counterbore bridge regions painted with "
"Ctrl+K. Each layer bridges from a rotated direction, progressively closing "
"the hole. More layers produce a gentler overhang angle."
msgstr ""
"A Ctrl+K-val festett süllyesztett híd régiók átmeneti rétegeinek száma. "
"Minden réteg egy elforgatott irányból hidal, fokozatosan lezárva a furatot. "
"Több réteg enyhébb túlnyúlási szöget eredményez."

#: src/libslic3r/PrintConfig.cpp:815
msgid ""
"Fan speed for bridge infill extrusions. Used in both auto cooling and manual "
"fan control modes."
msgstr ""
"Ventilátor sebessége a híd kitöltés extrudálásaihoz. Mind az automatikus "
"hűtésnél, mind a kézi ventilátorvezérlési módban használatos."

