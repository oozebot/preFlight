#. TRN: Label for speed used to print infill above bridges.
#: src/libslic3r/PrintConfig.cpp:1017
msgid "Over bridges"
msgstr "Hidak felett"

#: src/libslic3r/PrintConfig.cpp:1019
msgid ""
"Speed for printing solid infill above bridges. Set to 0 to use solid infill "
"speed. If set as percentage, the speed is calculated over solid infill speed."
msgstr ""
"Sebesség a hidak feletti tömör kitöltés nyomtatásához. Állítsa 0-ra a tömör "
"kitöltés sebességének használatához. Ha százalékban van megadva, a sebesség "
"a tömör kitöltés sebessége alapján kerül kiszámításra."

#: src/libslic3r/PrintConfig.cpp:1022 src/libslic3r/PrintConfig.cpp:1046
#: src/libslic3r/PrintConfig.cpp:1055 src/libslic3r/PrintConfig.cpp:1064
#: src/libslic3r/PrintConfig.cpp:1073 src/libslic3r/PrintConfig.cpp:1417
