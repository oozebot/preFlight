#: src/libslic3r/PrintConfig.cpp:3139 src/libslic3r/PrintConfig.cpp:3407
#: src/libslic3r/PrintConfig.cpp:3415
msgid "mm/s²"
msgstr "mm/s²"

#: src/libslic3r/PrintConfig.cpp:792
msgid "Bridging angle"
msgstr "Hídkészítési szög"

#: src/libslic3r/PrintConfig.cpp:794
msgid ""
"Bridging angle override. If left to zero, the bridging angle will be "
"calculated automatically. Otherwise the provided angle will be used for all "
"bridges. Use 180° for zero angle."
msgstr ""
"Hídkészítési szög felülbírálása. Ha nullán hagyja, az áthidalási szög "
"automatikusan kiszámításra kerül. Ellenkező esetben a megadott szöget fogja "
"használni az összes híd esetében. Nulla szög esetén 180°-ot használjon."

#: src/libslic3r/PrintConfig.cpp:797 src/libslic3r/PrintConfig.cpp:1167
#: src/libslic3r/PrintConfig.cpp:1975 src/libslic3r/PrintConfig.cpp:2759
#: src/libslic3r/PrintConfig.cpp:3917 src/libslic3r/PrintConfig.cpp:4096
