#: src/libslic3r/PrintConfig.cpp:6459
msgid "Tilt up offset delay"
msgstr "Felfelé döntés eltolási késleltetése"

#: src/libslic3r/PrintConfig.cpp:6460
msgid "Delay after the tilt reaches 'tilt_up_offset_steps' position."
msgstr ""
"Késleltetés azután, hogy a döntés eléri a 'tilt_up_offset_steps' pozíciót."

#: src/libslic3r/PrintConfig.cpp:6468
msgid "Tilt up cycles"
msgstr "Felfelé döntés ciklusai"

#: src/libslic3r/PrintConfig.cpp:6469
