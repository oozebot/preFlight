msgid "Speed"
msgstr "Sebesség"

#: src/libslic3r/PrintConfig.cpp:1008
msgid "Speed for printing bridges."
msgstr "A hidak nyomtatási sebessége."

#: src/libslic3r/PrintConfig.cpp:1009 src/libslic3r/PrintConfig.cpp:1664
#: src/libslic3r/PrintConfig.cpp:1674 src/libslic3r/PrintConfig.cpp:1684
