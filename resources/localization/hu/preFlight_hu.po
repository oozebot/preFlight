msgstr "A felfelé döntés többi részének felosztására szolgáló ciklusok száma."

#: src/libslic3r/PrintConfig.cpp:6476
msgid "Tilt up delay"
msgstr "Felfelé döntés késleltetése"

#: src/libslic3r/PrintConfig.cpp:6477
