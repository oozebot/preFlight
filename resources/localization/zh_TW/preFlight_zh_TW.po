#: src/luminary/config/catalog/PrintConfig.cpp:4609
#: src/luminary/config/catalog/PrintConfig.cpp:5360
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:525
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:527
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:529
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:531
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:533
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:535
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:538
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:540
#: src/DSKY/GUI/Tab.cpp:3645
msgid "Extruders"
msgstr "擠出機"

#: src/luminary/config/catalog/PrintConfig.cpp:697
msgid ""
"The extruder which determines bed temperatures. Set to 0 to determine "
"temperatures based on the first printing extruder of the first and the "
"second layers."
msgstr ""
"決定熱床溫度的擠出機。設為 0 時，依第一層與第二層的第一個列印擠出機決定溫度。"

#: src/luminary/config/catalog/PrintConfig.cpp:705
#: src/luminary/gcode/emit/GCode.cpp:615
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:975
msgid "Before layer change G-code"
msgstr "換層前G-code"

#: src/luminary/config/catalog/PrintConfig.cpp:706
msgid ""
"This custom code is inserted at every layer change, right before the Z move. "
"Note that you can use placeholder variables for all preFlight settings as "
"well as [layer_num] and [layer_z]."
msgstr ""
"此自定義代碼將在每次打印層在 Z 軸移動前插入。請注意，您可以為所有 preFlight "
"設定以及 [layer_num] 和 [layer_z] 使用佔位符號變數。"

#: src/luminary/config/catalog/PrintConfig.cpp:716
msgid "Between objects G-code"
msgstr "模型之間的 G-code"

#: src/luminary/config/catalog/PrintConfig.cpp:718
msgid ""
"This code is inserted between objects when using sequential printing. By "
"default extruder and bed temperature are reset using non-wait command; "
"however if M104, M109, M140 or M190 are detected in this custom code, "
"preFlight will not add temperature commands. Note that you can use "
"placeholder variables for all preFlight settings, so you can put a \"M109 "
"S[first_layer_temperature]\" command wherever you want."
msgstr ""
"使用順序打印時，將此代碼插入模型之間。預設情況下使用非等待命令重置擠出機和載"
"台溫度；但若在此自定義代碼中檢測到 M104、M109、M140 或 M190，preFlight 將不會"
"添加溫度命令。請注意，您可以為所有 preFlight 設定使用佔位符號變數，因此您可以"
"在任何需要的地方放置 \"M109 S[first_layer_temperature]\" 命令。"

#. TRN Print Settings: "Bottom solid layers"
#: src/luminary/config/catalog/PrintConfig.cpp:727
#: src/luminary/config/catalog/PrintConfig.cpp:735
msgctxt "Layers"
msgid "Bottom"
msgstr "底部"

#: src/luminary/config/catalog/PrintConfig.cpp:729
msgid "Number of solid layers to generate on bottom surfaces."
msgstr "在底面上生成的實體層數。"

#: src/luminary/config/catalog/PrintConfig.cpp:730
#: src/luminary/layer/settings_spec/SettingsSpec.cpp:47
msgid "Bottom solid layers"
msgstr "底部實體層"

#: src/luminary/config/catalog/PrintConfig.cpp:737
msgid ""
"The number of bottom solid layers is increased above bottom_solid_layers if "
"necessary to satisfy minimum thickness of bottom shell."
msgstr ""
"如有必要，底部實體層的數量會增加到 bottom_solid_layers 以上，以滿足底殼的最小"
"厚度。"

