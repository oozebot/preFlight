msgstr "在 before_layer_gcode 中發現“G92 E0”，它與絕對擠出機定址不相容。"

#: src/luminary/pipeline/print/Print.cpp:1141
msgid ""
"\"G92 E0\" was found in layer_gcode, which is incompatible with absolute "
