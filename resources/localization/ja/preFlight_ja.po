msgstr "レイヤーを準備中"

#: src/luminary/pipeline/slice/PrintObjectSlice.cpp:715
msgid "Slicing volumes"
msgstr "ボリュームをスライス中"

#: src/luminary/pipeline/slice/PrintObjectSlice.cpp:721
msgid "Processing regions"
msgstr "領域を処理中"

#: src/luminary/pipeline/slice/PrintObjectSlice.cpp:835
msgid "Processing geometry"
msgstr "ジオメトリを処理中"

