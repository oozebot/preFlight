+// A required function that cannot be replaced after earlier ones in the same module already
+// were leaves the process with a split allocator, which is why ReplaceFunctionWithStore aborts.
+// This dry-runs every replacement the module is about to receive (the same functions as
+// doMallocReplacement) so that any refusal is found before the first byte is written; the
+// module is then skipped and the process keeps the runtime's own allocator.
+bool ReplacementIsPossible(const unicode_char_t *dllName)
+{
+    if (!BytecodesAreKnown(dllName))
+        return false;
+
+    HMODULE module = GetModuleHandle(dllName);
+    if (!module)
+        return false;
+
+    const char *storedFuncName[] = {"free", "_msize", "realloc", "_aligned_free", "_aligned_msize", "_aligned_realloc", 0};
+    for (int i=0; storedFuncName[i]; i++)
+        if (!ProbeReplacement(dllName, module, storedFuncName[i], FRR_FAIL))
+            return false;
+
+    for (size_t i = 0; i < arrayLength(c_routines_to_replace); i++)
+        if (!ProbeReplacement(dllName, module, c_routines_to_replace[i]._func, c_routines_to_replace[i]._on_error))
+            return false;
+
+    if (strcmp(dllName, "ucrtbase.dll") == 0) {
+        if (!ProbeReplacement(dllName, module, "_o_free", FRR_IGNORE))
+            return false;
+        if (!ProbeReplacement(dllName, module, "_free_base", FRR_IGNORE))
+            return false;
+    } else {
+        for (size_t i = 0; i < arrayLength(cxx_routines_to_replace); i++)
+            if (!ProbeReplacement(dllName, module, cxx_routines_to_replace[i]._func, cxx_routines_to_replace[i]._on_error))
+                return false;
+    }
+
+    return true;
+}
