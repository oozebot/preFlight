+// Dry run of the steps of ReplaceFunction that can fail for reasons other than the opcode
+// dictionary: the export must exist, its code page must accept the protection change the
+// trampoline insertion makes, and a location within jump distance must be obtainable and
+// made executable. Nothing is modified. Returns FRR_NOFUNC when the export is missing,
+// FRR_FAILED when a step is refused (the reason is recorded in the replacement log), else FRR_OK.
+FRR_TYPE ProbeFunction(const char* dllName, const char *funcName, HMODULE module)
+{
+    FARPROC inpFunc = GetProcAddress(module, funcName);
+    FunctionInfo functionInfo = { funcName, dllName };
+
+    if (!inpFunc)
+        return FRR_NOFUNC;
+
+    DWORD origProt = 0;
+    if (!VirtualProtect((void*)inpFunc, MAX_PROBE_SIZE, PAGE_EXECUTE_WRITECOPY, &origProt)) {
+        Log::record(functionInfo, "code page not writable", /*status*/ false);
+        return FRR_FAILED;
+    }
+    VirtualProtect((void*)inpFunc, MAX_PROBE_SIZE, origProt, &origProt);
+
+    UINT_PTR location = memProvider.GetLocation(Ptr2Addrint((void*)inpFunc));
+    if (!location) {
+        Log::record(functionInfo, "no trampoline location within jump distance", /*status*/ false);
+        return FRR_FAILED;
+    }
+    DWORD pageFlags = PAGE_EXECUTE_READWRITE;
+    if (!VirtualProtect(Addrint2Ptr(location), MAX_PROBE_SIZE, pageFlags, &pageFlags)) {
+        Log::record(functionInfo, "trampoline page not executable", /*status*/ false);
+        return FRR_FAILED;
+    }
+
+    return FRR_OK;
+}
