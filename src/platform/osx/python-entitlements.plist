<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The bundled Python's ctypes/libffi allocates executable trampoline
       memory when it builds a callback closure (pip imports _ctypes on
       startup). Under the hardened runtime macOS blocks this unless the
       process carries the entitlements below, and libffi then spins forever
       instead of failing. Both keys are required to cover every architecture:
       arm64 uses MAP_JIT (allow-jit); x86_64 uses plain executable mmap
       (allow-unsigned-executable-memory). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Python dlopens extension modules that are separately signed; keep
       library validation off so the interpreter can load them. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
